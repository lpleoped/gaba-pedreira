---
import { getImage } from "astro:assets";
import Base from "../../layouts/Base.astro";
import Pieza from "../../components/Pieza.astro";
import { sitio } from "../../site";
import {
  casoSiguiente,
  casosPublicados,
  etiquetaCliente,
  etiquetaEnlace,
  etiquetaOficios,
} from "../../lib/casos";

export async function getStaticPaths() {
  const casos = await casosPublicados();
  return casos.map((caso) => ({
    params: { slug: caso.data.slug },
    props: { id: caso.id },
  }));
}

interface Props {
  id: string;
}

const { id } = Astro.props;
const casos = await casosPublicados();
const caso = casos.find((entrada) => entrada.id === id);
if (!caso) {
  throw new Error("Caso no encontrado");
}

const siguiente = casoSiguiente(casos, caso);
const descripcion = caso.data.og?.descripcion ?? caso.data.desafio;
const titulo = `${caso.data.titulo} — ${sitio.nombre}`;
const fuenteOg = caso.data.og?.imagen ?? caso.data.pieza.imagen ?? caso.data.pieza.poster;
const og = fuenteOg
  ? await getImage({ src: fuenteOg, width: Math.min(fuenteOg.width, 1200), format: "jpg", quality: 82 })
  : undefined;
const imagen = og?.src;
const tieneVideo = Boolean(caso.data.pieza.video);
type Fila = { etiqueta: string; en: string; valor?: string; valorEn?: string };
const ficha = (
  [
    { etiqueta: "Rol", en: "Role", valor: caso.data.rol },
    {
      etiqueta: "Con",
      en: "With",
      valor: caso.data.colaboradores.length ? caso.data.colaboradores.join(", ") : undefined,
    },
    { etiqueta: "Cliente", en: "Client", valor: caso.data.cliente },
    { etiqueta: "Año", en: "Year", valor: String(caso.data.anio) },
    {
      etiqueta: "Disciplina",
      en: "Discipline",
      valor: etiquetaOficios(caso),
      valorEn: etiquetaOficios(caso, "en"),
    },
  ] satisfies Fila[]
).filter((fila): fila is Fila & { valor: string } => Boolean(fila.valor));
---

<Base
  titulo={caso.data.og?.titulo ?? titulo}
  descripcion={descripcion}
  imagen={imagen}
  prefetch={siguiente ? `/trabajo/${siguiente.data.slug}` : undefined}
>
  <article class="caso" style={`--caso: ${caso.data.colorDeCaso}`}>
    <h1 class="caso-titulo">{caso.data.titulo}</h1>
    <dl class="ficha">
      {
        ficha.map(({ etiqueta, en, valor, valorEn }) => (
          <div>
            <dt data-en={en}>{etiqueta}</dt>
            <dd data-en={valorEn}>{valor}</dd>
          </div>
        ))
      }
      {
        caso.data.enlace && (
          <div>
            <dt data-en="View">Ver</dt>
            <dd>
              <a href={caso.data.enlace} rel="noopener noreferrer" data-en={etiquetaEnlace(caso.data.enlace, "en")}>
                {etiquetaEnlace(caso.data.enlace)}
              </a>
            </dd>
          </div>
        )
      }
    </dl>
    <p class="desafio">{caso.data.desafio}</p>
    <Pieza medio={caso.data.pieza} principal />
    {
      caso.data.apoyos.length > 0 && (
        <div class="apoyos">
          {caso.data.apoyos.map((apoyo) => (
            <Pieza medio={apoyo} />
          ))}
        </div>
      )
    }
    {
      caso.data.premios.length > 0 && (
        <ul class="premios">
          {caso.data.premios.map((premio) => (
            <li>
              {premio.nombre}, {premio.anio}
            </li>
          ))}
        </ul>
      )
    }
    {
      siguiente && (
        <a class="siguiente" href={`/trabajo/${siguiente.data.slug}`}>
          <span data-en="Next">Siguiente</span>
          <span class="siguiente-titulo">{siguiente.data.titulo}</span>
          <span data-en={`${etiquetaCliente(siguiente, "en")}, ${siguiente.data.anio}`}>
            {etiquetaCliente(siguiente)}, {siguiente.data.anio}
          </span>
        </a>
      )
    }
  </article>
  {
    tieneVideo && (
      <script>
        import "../../scripts/caso.ts";
      </script>
    )
  }
</Base>
